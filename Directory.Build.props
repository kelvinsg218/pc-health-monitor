<Project>
  <PropertyGroup>
    <LangVersion>latest</LangVersion>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <AnalysisLevel>latest-recommended</AnalysisLevel>
    <!-- net8.0 (LTS) is the target. RollForward lets the app and tests run on a newer
         runtime (e.g. only .NET 9 installed) when the .NET 8 runtime is not present. -->
    <RollForward>Major</RollForward>
    <!-- CA1848: LoggerMessage delegates only matter for hot-path logging; this CLI logs rarely. -->
    <NoWarn>$(NoWarn);CA1848</NoWarn>
    <Version>1.0.0</Version>
    <Product>PC Health Monitor</Product>
    <Company>PC Health Monitor</Company>
  </PropertyGroup>
</Project>
