{
  "PcHealth": {
    "Thresholds": {
      "CpuWarning": 75,
      "CpuCritical": 90,
      "MemoryWarning": 80,
      "MemoryCritical": 92,
      "StorageWarning": 80,
      "StorageCritical": 90,
      "TemperatureWarning": 85,
      "TemperatureCritical": 95,
      "UptimeNoticeDays": 30
    },
    "Scan": {
      "DurationSeconds": 5,
      "SampleIntervalSeconds": 1,
      "StatusCpuSampleSeconds": 1
    },
    "Monitor": {
      "RefreshIntervalSeconds": 2
    },
    "Processes": {
      "TopCount": 10,
      "CpuSampleSeconds": 1
    },
    "History": {
      "RetentionDays": 365,
      "DefaultListLimit": 20
    },
    "Paths": {
      "DataDirectory": "data",
      "ReportsDirectory": "reports",
      "LogsDirectory": "logs",
      "DatabaseFileName": "pchealth.db"
    }
  }
}
