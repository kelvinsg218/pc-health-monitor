<Window x:Class="PCHealthMonitor.Desktop.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:infra="clr-namespace:PCHealthMonitor.Desktop.Infrastructure"
        Title="{Binding Title}"
        Icon="pack://application:,,,/Assets/app.ico"
        Width="1240" Height="820" MinWidth="880" MinHeight="600"
        WindowStartupLocation="CenterScreen"
        Background="{StaticResource BgBrush}"
        Foreground="{StaticResource TextBrush}"
        FontFamily="{StaticResource UiFont}" FontSize="13"
        UseLayoutRounding="True" TextOptions.TextFormattingMode="Display">

    <Window.Resources>
        <!-- Status pill bound to a status label (OK / WARNING / CRITICAL / UNKNOWN / HEALTHY / ATTENTION / INFO) -->
        <DataTemplate x:Key="PillTemplate">
            <Border Style="{StaticResource Pill}" Background="{Binding Converter={StaticResource StatusBrush}, ConverterParameter=soft}">
                <TextBlock Text="{Binding Converter={StaticResource StatusText}}" FontSize="11" FontWeight="SemiBold" Foreground="{Binding Converter={StaticResource StatusBrush}}" />
            </Border>
        </DataTemplate>

        <!-- Alert / message row -->
        <DataTemplate x:Key="MessageTemplate">
            <Grid Margin="0,4">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="92" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <ContentPresenter Content="{Binding Severity}" ContentTemplate="{StaticResource PillTemplate}" VerticalAlignment="Top" />
                <TextBlock Grid.Column="1" TextWrapping="Wrap" VerticalAlignment="Center">
                    <Run Text="{Binding Component, Mode=OneWay}" Foreground="{StaticResource MutedBrush}" /><Run Text=" · " Foreground="{StaticResource MutedBrush}" /><Run Text="{Binding Text, Mode=OneWay}" />
                </TextBlock>
            </Grid>
        </DataTemplate>

        <Style x:Key="Banner" TargetType="Border">
            <Setter Property="CornerRadius" Value="8" />
            <Setter Property="Padding" Value="14,10" />
            <Setter Property="Margin" Value="6,0,6,12" />
            <Setter Property="BorderThickness" Value="1" />
        </Style>
        <Style x:Key="ErrorBanner" TargetType="Border" BasedOn="{StaticResource Banner}">
            <Setter Property="Background" Value="#2A1715" />
            <Setter Property="BorderBrush" Value="{StaticResource CriticalBrush}" />
        </Style>
        <Style x:Key="WarnBanner" TargetType="Border" BasedOn="{StaticResource Banner}">
            <Setter Property="Background" Value="#2A2214" />
            <Setter Property="BorderBrush" Value="{StaticResource WarningBrush}" />
        </Style>

        <Style x:Key="PageHeader" TargetType="TextBlock" BasedOn="{StaticResource TitleText}">
            <Setter Property="Margin" Value="6,0,6,4" />
        </Style>
        <Style x:Key="PageSub" TargetType="TextBlock" BasedOn="{StaticResource MutedText}">
            <Setter Property="Margin" Value="6,0,6,16" />
        </Style>
    </Window.Resources>

    <TabControl SelectedIndex="{Binding SelectedTab}" Background="Transparent" BorderThickness="0" Padding="0"
                ItemContainerStyle="{StaticResource NavTab}">
        <TabControl.Template>
            <ControlTemplate TargetType="TabControl">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="220" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>

                    <!-- Sidebar -->
                    <Border Background="{StaticResource SurfaceBrush}" BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,0,1,0">
                        <DockPanel>
                            <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Margin="20,22,12,26">
                                <Image Source="pack://application:,,,/Assets/app-256.png" Width="34" Height="34" RenderOptions.BitmapScalingMode="HighQuality" />
                                <StackPanel Margin="10,0,0,0" VerticalAlignment="Center">
                                    <TextBlock Text="PC Health" FontSize="15" FontWeight="SemiBold" Foreground="{StaticResource TextBrush}" />
                                    <TextBlock Text="Monitor" FontSize="15" FontWeight="SemiBold" Foreground="{StaticResource AccentBrush}" Margin="0,-3,0,0" />
                                </StackPanel>
                            </StackPanel>
                            <StackPanel DockPanel.Dock="Bottom" Margin="20,0,16,18">
                                <TextBlock Text="Diagnóstico somente leitura" Foreground="{StaticResource MutedBrush}" FontSize="11" />
                                <TextBlock Text="Os dados ficam neste computador" Foreground="{StaticResource MutedBrush}" FontSize="11" />
                                <TextBlock Foreground="{StaticResource MutedBrush}" FontSize="11" Margin="0,6,0,0">
                                    <Run Text="Versão " /><Run Text="{Binding Version, Mode=OneWay}" />
                                </TextBlock>
                            </StackPanel>
                            <StackPanel IsItemsHost="True" />
                        </DockPanel>
                    </Border>

                    <ContentPresenter x:Name="PART_SelectedContentHost" Grid.Column="1" ContentSource="SelectedContent" />
                </Grid>
            </ControlTemplate>
        </TabControl.Template>

        <!-- ===================== DASHBOARD ===================== -->
        <TabItem Header="Painel">
            <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" DataContext="{Binding Dashboard}">
                <StackPanel Margin="22,22,22,22">

                    <!-- Header: machine + overall health -->
                    <infra:AdaptiveGrid MinItemWidth="380" MaxColumns="2" Margin="0,0,0,10">
                        <StackPanel Margin="6,0,6,10">
                            <TextBlock Text="{Binding Machine}" Style="{StaticResource TitleText}" />
                            <TextBlock Text="{Binding Windows}" Style="{StaticResource MutedText}" Margin="0,2,0,0" />
                            <TextBlock Style="{StaticResource MutedText}" Margin="0,2,0,0">
                                <Run Text="Tempo ligado: " /><Run Text="{Binding Uptime, Mode=OneWay}" Foreground="{StaticResource TextBrush}" />
                                <Run Text="  ·  Atualizado às " /><Run Text="{Binding LastUpdated, Mode=OneWay}" Foreground="{StaticResource TextBrush}" />
                            </TextBlock>
                            <TextBlock Text="{Binding RefreshText}" Style="{StaticResource MutedText}" FontSize="11" Margin="0,2,0,0" />
                        </StackPanel>

                        <Border Style="{StaticResource Card}" Margin="6,0"
                                BorderBrush="{Binding Overall, Converter={StaticResource StatusBrush}}">
                            <StackPanel>
                                <TextBlock Text="SAÚDE GERAL (AO VIVO)" Style="{StaticResource SectionText}" Margin="0,0,0,4" />
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="{Binding Overall, Converter={StaticResource StatusText}}" FontSize="26" FontWeight="SemiBold"
                                               Foreground="{Binding Overall, Converter={StaticResource StatusBrush}}" />
                                    <TextBlock Text="  dados incompletos" Foreground="{StaticResource MutedBrush}" VerticalAlignment="Bottom" Margin="0,0,0,5"
                                               Visibility="{Binding IsIncomplete, Converter={StaticResource BoolToVisibility}}" />
                                </StackPanel>
                                <TextBlock Text="{Binding OverallReason}" TextWrapping="Wrap" Foreground="{StaticResource MutedBrush}" Margin="0,4,0,0" />
                            </StackPanel>
                        </Border>
                    </infra:AdaptiveGrid>

                    <!-- Banners -->
                    <Border Style="{StaticResource WarnBanner}"
                            Visibility="{Binding DataContext.ConfigurationWarning, RelativeSource={RelativeSource AncestorType=Window}, Converter={StaticResource NotEmptyToVisibility}}">
                        <TextBlock Text="{Binding DataContext.ConfigurationWarning, RelativeSource={RelativeSource AncestorType=Window}}" TextWrapping="Wrap" />
                    </Border>
                    <Border Style="{StaticResource ErrorBanner}" Visibility="{Binding ErrorMessage, Converter={StaticResource NotEmptyToVisibility}}">
                        <TextBlock Text="{Binding ErrorMessage}" TextWrapping="Wrap" />
                    </Border>
                    <Border Style="{StaticResource Card}" Visibility="{Binding IsLoading, Converter={StaticResource BoolToVisibility}}">
                        <StackPanel>
                            <TextBlock Text="Coletando as primeiras medições…" Margin="0,0,0,10" />
                            <ProgressBar IsIndeterminate="{Binding IsLoading, Mode=OneWay}" />
                        </StackPanel>
                    </Border>

                    <!-- Main metric cards -->
                    <infra:AdaptiveGrid MinItemWidth="290" MaxColumns="3">
                        <!-- CPU -->
                        <Border Style="{StaticResource Card}">
                            <StackPanel>
                                <Grid>
                                    <TextBlock Text="CPU" Style="{StaticResource SectionText}" />
                                    <ContentPresenter Content="{Binding CpuStatus}" ContentTemplate="{StaticResource PillTemplate}" HorizontalAlignment="Right" VerticalAlignment="Top" />
                                </Grid>
                                <TextBlock Text="{Binding CpuValue}" Style="{StaticResource BigValueText}" />
                                <ProgressBar Value="{Binding CpuPercent, Mode=OneWay}" Maximum="100" Margin="0,8,0,10"
                                             Foreground="{Binding CpuStatus, Converter={StaticResource StatusBrush}}" />
                                <infra:Sparkline Values="{Binding CpuSeries}" Height="44" Capacity="60" Stroke="{StaticResource AccentBrush}"
                                                 ToolTip="Uso de CPU nas últimas 60 atualizações" />
                                <TextBlock Text="{Binding CpuModel}" Margin="0,10,0,0" TextTrimming="CharacterEllipsis" ToolTip="{Binding CpuModel}" />
                                <TextBlock Text="{Binding CpuDetail}" Style="{StaticResource MutedText}" />
                            </StackPanel>
                        </Border>

                        <!-- Memory -->
                        <Border Style="{StaticResource Card}">
                            <StackPanel>
                                <Grid>
                                    <TextBlock Text="MEMÓRIA (RAM)" Style="{StaticResource SectionText}" />
                                    <ContentPresenter Content="{Binding MemoryStatus}" ContentTemplate="{StaticResource PillTemplate}" HorizontalAlignment="Right" VerticalAlignment="Top" />
                                </Grid>
                                <TextBlock Text="{Binding MemoryValue}" Style="{StaticResource BigValueText}" />
                                <ProgressBar Value="{Binding MemoryPercent, Mode=OneWay}" Maximum="100" Margin="0,8,0,10"
                                             Foreground="{Binding MemoryStatus, Converter={StaticResource StatusBrush}}" />
                                <TextBlock Text="{Binding MemoryDetail}" />
                                <TextBlock Text="{Binding MemorySub}" Style="{StaticResource MutedText}" />
                            </StackPanel>
                        </Border>

                        <!-- Temperature -->
                        <Border Style="{StaticResource Card}">
                            <StackPanel>
                                <Grid>
                                    <TextBlock Text="TEMPERATURA" Style="{StaticResource SectionText}" />
                                    <ContentPresenter Content="{Binding TemperatureStatus}" ContentTemplate="{StaticResource PillTemplate}" HorizontalAlignment="Right" VerticalAlignment="Top" />
                                </Grid>
                                <TextBlock Text="{Binding TemperatureValue}" Style="{StaticResource BigValueText}" />
                                <TextBlock Text="{Binding TemperatureDetail}" Style="{StaticResource MutedText}" Margin="0,10,0,0" />
                            </StackPanel>
                        </Border>
                    </infra:AdaptiveGrid>

                    <!-- Storage -->
                    <TextBlock Text="ARMAZENAMENTO · UNIDADES FIXAS LOCAIS" Style="{StaticResource SectionText}" Margin="6,14,6,2" />
                    <ItemsControl ItemsSource="{Binding Drives}">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <infra:AdaptiveGrid MinItemWidth="290" MaxColumns="3" />
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border Style="{StaticResource Card}">
                                    <StackPanel>
                                        <Grid>
                                            <StackPanel Orientation="Horizontal">
                                                <TextBlock Text="{Binding Name}" FontSize="16" FontWeight="SemiBold" />
                                                <TextBlock Text="{Binding Subtitle}" Style="{StaticResource MutedText}" Margin="8,0,0,0" VerticalAlignment="Bottom" />
                                            </StackPanel>
                                            <ContentPresenter Content="{Binding Status}" ContentTemplate="{StaticResource PillTemplate}" HorizontalAlignment="Right" />
                                        </Grid>
                                        <TextBlock Text="{Binding Value}" Style="{StaticResource BigValueText}" FontSize="26" Margin="0,6,0,0" />
                                        <ProgressBar Value="{Binding Percent, Mode=OneWay}" Maximum="100" Margin="0,6,0,8"
                                                     Foreground="{Binding Status, Converter={StaticResource StatusBrush}}" />
                                        <TextBlock Text="{Binding Detail}" Style="{StaticResource MutedText}" />
                                    </StackPanel>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>

                    <!-- Alerts -->
                    <TextBlock Text="ALERTAS" Style="{StaticResource SectionText}" Margin="6,14,6,2" />
                    <Border Style="{StaticResource Card}">
                        <StackPanel>
                            <TextBlock Text="Nenhum alerta. Todos os componentes monitorados estão dentro dos limites configurados." Foreground="{StaticResource AccentBrush}"
                                       Visibility="{Binding Alerts.Count, Converter={StaticResource NotEmptyToVisibility}, ConverterParameter=invert}" />
                            <ItemsControl ItemsSource="{Binding Alerts}" ItemTemplate="{StaticResource MessageTemplate}" />
                        </StackPanel>
                    </Border>

                    <!-- Notes -->
                    <TextBlock Text="OBSERVAÇÕES" Style="{StaticResource SectionText}" Margin="6,14,6,2"
                               Visibility="{Binding Notes.Count, Converter={StaticResource NotEmptyToVisibility}}" />
                    <Border Style="{StaticResource Card}" Visibility="{Binding Notes.Count, Converter={StaticResource NotEmptyToVisibility}}">
                        <ItemsControl ItemsSource="{Binding Notes}" ItemTemplate="{StaticResource MessageTemplate}" />
                    </Border>
                </StackPanel>
            </ScrollViewer>
        </TabItem>

        <!-- ===================== PROCESSES ===================== -->
        <TabItem Header="Processos">
            <Grid Margin="22" DataContext="{Binding Processes}">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>
                <Grid>
                    <TextBlock Text="Principais processos" Style="{StaticResource PageHeader}" />
                    <Button Content="Atualizar" Command="{Binding RefreshCommand}" HorizontalAlignment="Right" Style="{StaticResource PrimaryButton}" Margin="6,0" />
                </Grid>
                <TextBlock Grid.Row="1" Text="{Binding Summary}" Style="{StaticResource PageSub}" />
                <StackPanel Grid.Row="2">
                    <ProgressBar IsIndeterminate="{Binding IsBusy, Mode=OneWay}" Margin="6,0,6,12" Visibility="{Binding IsBusy, Converter={StaticResource BoolToVisibility}}" />
                    <Border Style="{StaticResource ErrorBanner}" Visibility="{Binding ErrorMessage, Converter={StaticResource NotEmptyToVisibility}}">
                        <TextBlock Text="{Binding ErrorMessage}" TextWrapping="Wrap" />
                    </Border>
                </StackPanel>
                <Grid Grid.Row="3">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <Border Style="{StaticResource Card}">
                        <DockPanel>
                            <TextBlock DockPanel.Dock="Top" Text="POR MEMÓRIA (WORKING SET)" Style="{StaticResource SectionText}" />
                            <DataGrid ItemsSource="{Binding TopMemory}">
                                <DataGrid.Columns>
                                    <DataGridTextColumn Header="PID" Binding="{Binding Pid}" Width="70" />
                                    <DataGridTextColumn Header="PROCESSO" Binding="{Binding Name}" Width="*" />
                                    <DataGridTextColumn Header="MEMÓRIA" Binding="{Binding Memory}" Width="100" />
                                </DataGrid.Columns>
                            </DataGrid>
                        </DockPanel>
                    </Border>
                    <Border Grid.Column="1" Style="{StaticResource Card}">
                        <DockPanel>
                            <TextBlock DockPanel.Dock="Top" Text="POR CPU (% DA CAPACIDADE TOTAL DE CPU)" Style="{StaticResource SectionText}" />
                            <DataGrid ItemsSource="{Binding TopCpu}">
                                <DataGrid.Columns>
                                    <DataGridTextColumn Header="PID" Binding="{Binding Pid}" Width="70" />
                                    <DataGridTextColumn Header="PROCESSO" Binding="{Binding Name}" Width="*" />
                                    <DataGridTextColumn Header="CPU" Binding="{Binding Cpu}" Width="80" />
                                </DataGrid.Columns>
                            </DataGrid>
                        </DockPanel>
                    </Border>
                </Grid>
            </Grid>
        </TabItem>

        <!-- ===================== FULL SCAN ===================== -->
        <TabItem Header="Verificação completa">
            <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" DataContext="{Binding Scan}">
                <StackPanel Margin="22">
                    <TextBlock Text="Verificação completa" Style="{StaticResource PageHeader}" />
                    <TextBlock Text="{Binding Description}" Style="{StaticResource PageSub}" />

                    <Border Style="{StaticResource Card}">
                        <StackPanel>
                            <WrapPanel>
                                <Button Content="Executar verificação completa" AutomationProperties.AutomationId="RunScanButton" Command="{Binding RunCommand}" Style="{StaticResource PrimaryButton}" Margin="0,0,10,6" />
                                <Button Content="Cancelar" AutomationProperties.AutomationId="CancelScanButton" Command="{Binding CancelCommand}" Margin="0,0,18,6" />
                                <CheckBox Content="Gerar também um relatório (JSON + TXT)" IsChecked="{Binding GenerateReport}" VerticalAlignment="Center" Margin="0,0,0,6"
                                          IsEnabled="{Binding IsRunning, Converter={StaticResource InverseBool}}" />
                            </WrapPanel>
                            <ProgressBar IsIndeterminate="{Binding IsRunning, Mode=OneWay}" Margin="0,10,0,0" Visibility="{Binding IsRunning, Converter={StaticResource BoolToVisibility}}" />
                            <TextBlock Text="{Binding ProgressText}" Style="{StaticResource MutedText}" Margin="0,8,0,0"
                                       Visibility="{Binding ProgressText, Converter={StaticResource NotEmptyToVisibility}}" />
                        </StackPanel>
                    </Border>

                    <Border Style="{StaticResource ErrorBanner}" Margin="6,12,6,0" Visibility="{Binding ErrorMessage, Converter={StaticResource NotEmptyToVisibility}}">
                        <TextBlock Text="{Binding ErrorMessage}" TextWrapping="Wrap" />
                    </Border>

                    <StackPanel Visibility="{Binding HasResult, Converter={StaticResource BoolToVisibility}}" Margin="0,12,0,0">
                        <Border Style="{StaticResource Card}" BorderBrush="{Binding Overall, Converter={StaticResource StatusBrush}}">
                            <StackPanel>
                                <TextBlock Text="RESULTADO" Style="{StaticResource SectionText}" />
                                <TextBlock Text="{Binding Overall, Converter={StaticResource StatusText}}" FontSize="26" FontWeight="SemiBold" Foreground="{Binding Overall, Converter={StaticResource StatusBrush}}" />
                                <TextBlock Text="{Binding ResultHeader}" Style="{StaticResource MutedText}" />
                                <TextBlock Text="{Binding SavedText}" Margin="0,8,0,0" Visibility="{Binding SavedText, Converter={StaticResource NotEmptyToVisibility}}" />
                                <StackPanel Orientation="Horizontal" Margin="0,8,0,0" Visibility="{Binding ReportPath, Converter={StaticResource NotEmptyToVisibility}}">
                                    <TextBlock Text="{Binding ReportPath}" Style="{StaticResource MutedText}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" MaxWidth="620" />
                                    <Button Content="Abrir pasta do relatório" Command="{Binding OpenReportsCommand}" Margin="12,0,0,0" />
                                </StackPanel>
                            </StackPanel>
                        </Border>

                        <Border Style="{StaticResource Card}">
                            <DockPanel>
                                <TextBlock DockPanel.Dock="Top" Text="COMPONENTES" Style="{StaticResource SectionText}" />
                                <DataGrid ItemsSource="{Binding Components}">
                                    <DataGrid.Columns>
                                        <DataGridTextColumn Header="COMPONENTE" Binding="{Binding Name}" Width="150" />
                                        <DataGridTemplateColumn Header="ESTADO" Width="110">
                                            <DataGridTemplateColumn.CellTemplate>
                                                <DataTemplate>
                                                    <ContentPresenter Content="{Binding Status}" ContentTemplate="{StaticResource PillTemplate}" />
                                                </DataTemplate>
                                            </DataGridTemplateColumn.CellTemplate>
                                        </DataGridTemplateColumn>
                                        <DataGridTextColumn Header="EVIDÊNCIA" Binding="{Binding Value}" Width="*" />
                                    </DataGrid.Columns>
                                </DataGrid>
                            </DockPanel>
                        </Border>

                        <Border Style="{StaticResource Card}">
                            <StackPanel>
                                <TextBlock Text="MENSAGENS DE DIAGNÓSTICO" Style="{StaticResource SectionText}" />
                                <ItemsControl ItemsSource="{Binding Messages}" ItemTemplate="{StaticResource MessageTemplate}" />
                            </StackPanel>
                        </Border>

                        <Border Style="{StaticResource Card}" Visibility="{Binding ComparisonHeader, Converter={StaticResource NotEmptyToVisibility}}">
                            <DockPanel>
                                <TextBlock DockPanel.Dock="Top" Text="{Binding ComparisonHeader}" Style="{StaticResource SectionText}" TextWrapping="Wrap" />
                                <DataGrid ItemsSource="{Binding Changes}">
                                    <DataGrid.Columns>
                                        <DataGridTextColumn Header="MÉTRICA" Binding="{Binding Metric}" Width="*" />
                                        <DataGridTextColumn Header="ANTERIOR" Binding="{Binding Previous}" Width="110" />
                                        <DataGridTextColumn Header="ATUAL" Binding="{Binding Current}" Width="110" />
                                        <DataGridTextColumn Header="MUDANÇA" Binding="{Binding Change}" Width="2*" />
                                    </DataGrid.Columns>
                                </DataGrid>
                            </DockPanel>
                        </Border>
                    </StackPanel>
                </StackPanel>
            </ScrollViewer>
        </TabItem>

        <!-- ===================== HISTORY ===================== -->
        <TabItem Header="Histórico">
            <Grid Margin="22" DataContext="{Binding History}">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>
                <Grid>
                    <TextBlock Text="Histórico" Style="{StaticResource PageHeader}" />
                    <Button Content="Atualizar" Command="{Binding RefreshCommand}" HorizontalAlignment="Right" Margin="6,0" />
                </Grid>
                <TextBlock Grid.Row="1" Text="{Binding Summary}" Style="{StaticResource PageSub}" />
                <StackPanel Grid.Row="2">
                    <ProgressBar IsIndeterminate="{Binding IsBusy, Mode=OneWay}" Margin="6,0,6,12" Visibility="{Binding IsBusy, Converter={StaticResource BoolToVisibility}}" />
                    <Border Style="{StaticResource ErrorBanner}" Visibility="{Binding ErrorMessage, Converter={StaticResource NotEmptyToVisibility}}">
                        <TextBlock Text="{Binding ErrorMessage}" TextWrapping="Wrap" />
                    </Border>
                </StackPanel>
                <Grid Grid.Row="3">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="5*" MinWidth="380" />
                        <ColumnDefinition Width="3*" MinWidth="280" />
                    </Grid.ColumnDefinitions>
                    <Border Style="{StaticResource Card}">
                        <DataGrid ItemsSource="{Binding Scans}" SelectedItem="{Binding Selected}" HorizontalScrollBarVisibility="Disabled">
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="ID" Binding="{Binding Id}" Width="0.5*" MinWidth="30" />
                                <DataGridTextColumn Header="DATA" Binding="{Binding Date}" Width="1.8*" MinWidth="122" />
                                <DataGridTextColumn Header="CPU MÉD." Binding="{Binding CpuAverage}" Width="*" MinWidth="74" />
                                <DataGridTextColumn Header="PICO" Binding="{Binding CpuPeak}" Width="*" MinWidth="52" />
                                <DataGridTextColumn Header="MEMÓRIA" Binding="{Binding Memory}" Width="*" MinWidth="78" />
                                <DataGridTextColumn Header="DISCO MÁX." Binding="{Binding DiskMax}" Width="1.3*" MinWidth="86" />
                                <DataGridTemplateColumn Header="SAÚDE" Width="1.4*" MinWidth="84">
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate>
                                            <ContentPresenter Content="{Binding Health}" ContentTemplate="{StaticResource PillTemplate}" />
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                </DataGridTemplateColumn>
                            </DataGrid.Columns>
                        </DataGrid>
                    </Border>
                    <Border Grid.Column="1" Style="{StaticResource Card}">
                        <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                            <StackPanel>
                                <TextBlock Text="Selecione uma verificação para ver os detalhes." Style="{StaticResource MutedText}"
                                           Visibility="{Binding DetailHeader, Converter={StaticResource NotEmptyToVisibility}, ConverterParameter=invert}" />
                                <TextBlock Text="{Binding DetailHeader}" TextWrapping="Wrap" FontWeight="SemiBold" Margin="0,0,0,10" />
                                <ItemsControl ItemsSource="{Binding Details}">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Grid Margin="0,3">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="100" />
                                                    <ColumnDefinition Width="96" />
                                                    <ColumnDefinition Width="*" />
                                                </Grid.ColumnDefinitions>
                                                <TextBlock Text="{Binding Name}" Foreground="{StaticResource MutedBrush}" VerticalAlignment="Center" />
                                                <ContentPresenter Grid.Column="1" Content="{Binding Status}" ContentTemplate="{StaticResource PillTemplate}" />
                                                <TextBlock Grid.Column="2" Text="{Binding Value}" TextWrapping="Wrap" VerticalAlignment="Center" />
                                            </Grid>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                                <TextBlock Text="MENSAGENS" Style="{StaticResource SectionText}" Margin="0,14,0,4"
                                           Visibility="{Binding Messages.Count, Converter={StaticResource NotEmptyToVisibility}}" />
                                <ItemsControl ItemsSource="{Binding Messages}" ItemTemplate="{StaticResource MessageTemplate}" />
                                <TextBlock Text="{Binding ComparisonHeader}" Style="{StaticResource SectionText}" TextWrapping="Wrap" Margin="0,14,0,4"
                                           Visibility="{Binding ComparisonHeader, Converter={StaticResource NotEmptyToVisibility}}" />
                                <ItemsControl ItemsSource="{Binding Changes}">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Grid Margin="0,2">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="130" />
                                                    <ColumnDefinition Width="140" />
                                                    <ColumnDefinition Width="*" />
                                                </Grid.ColumnDefinitions>
                                                <TextBlock Text="{Binding Metric}" Foreground="{StaticResource MutedBrush}" />
                                                <TextBlock Grid.Column="1">
                                                    <Run Text="{Binding Previous, Mode=OneWay}" /><Run Text=" → " Foreground="{StaticResource MutedBrush}" /><Run Text="{Binding Current, Mode=OneWay}" />
                                                </TextBlock>
                                                <TextBlock Grid.Column="2" Text="{Binding Change}" TextWrapping="Wrap" />
                                            </Grid>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </StackPanel>
                        </ScrollViewer>
                    </Border>
                </Grid>
            </Grid>
        </TabItem>

        <!-- ===================== ABOUT ===================== -->
        <TabItem Header="Sobre">
            <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                <StackPanel Margin="22" MaxWidth="900" HorizontalAlignment="Left">
                    <TextBlock Text="Sobre o PC Health Monitor" Style="{StaticResource PageHeader}" />
                    <TextBlock Style="{StaticResource PageSub}">
                        <Run Text="Versão " /><Run Text="{Binding Version, Mode=OneWay}" /><Run Text=" · " /><Run Text="{Binding RuntimeText, Mode=OneWay}" />
                    </TextBlock>

                    <Border Style="{StaticResource Card}">
                        <StackPanel>
                            <TextBlock Text="O QUE ESTE APLICATIVO FAZ" Style="{StaticResource SectionText}" />
                            <TextBlock TextWrapping="Wrap" Text="Lê informações de CPU, memória, unidades locais e (quando o Windows disponibiliza) temperatura, classifica cada componente como OK, ALERTA, CRÍTICO ou DESCONHECIDO usando os limites abaixo e mantém um histórico local das verificações completas para você acompanhar como este computador muda ao longo do tempo." />
                            <TextBlock TextWrapping="Wrap" Margin="0,8,0,0" Foreground="{StaticResource MutedBrush}"
                                       Text="É uma ferramenta de diagnóstico somente leitura: nunca altera configurações, nunca encerra ou modifica processos, nunca apaga arquivos e nunca pede privilégios de administrador. As decisões de manutenção ficam com você." />
                        </StackPanel>
                    </Border>

                    <Border Style="{StaticResource Card}">
                        <StackPanel>
                            <TextBlock Text="LIMITES (ALERTA / CRÍTICO)" Style="{StaticResource SectionText}" />
                            <TextBlock Text="{Binding ThresholdsText}" TextWrapping="Wrap" />
                            <TextBlock TextWrapping="Wrap" Margin="0,8,0,0" Style="{StaticResource MutedText}"
                                       Text="DESCONHECIDO significa que uma métrica não pôde ser lida; isso nunca piora o resultado geral por si só. Configurações opcionais: coloque um arquivo appsettings.json ao lado do PCHealthMonitor.exe (veja o README)." />
                        </StackPanel>
                    </Border>

                    <Border Style="{StaticResource Card}">
                        <StackPanel>
                            <TextBlock Text="PRIVACIDADE E DADOS LOCAIS" Style="{StaticResource SectionText}" />
                            <TextBlock TextWrapping="Wrap" Text="Nada é enviado pela rede. Verificações, relatórios e logs ficam armazenados apenas neste computador, para o seu usuário do Windows:" />
                            <Grid Margin="0,10,0,0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="90" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <Grid.RowDefinitions>
                                    <RowDefinition />
                                    <RowDefinition />
                                    <RowDefinition />
                                </Grid.RowDefinitions>
                                <TextBlock Text="Histórico" Foreground="{StaticResource MutedBrush}" />
                                <TextBox Grid.Column="1" Text="{Binding DatabaseFile, Mode=OneWay}" IsReadOnly="True" BorderThickness="0" Background="Transparent" />
                                <TextBlock Grid.Row="1" Text="Relatórios" Foreground="{StaticResource MutedBrush}" />
                                <TextBox Grid.Row="1" Grid.Column="1" Text="{Binding ReportsFolder, Mode=OneWay}" IsReadOnly="True" BorderThickness="0" Background="Transparent" />
                                <TextBlock Grid.Row="2" Text="Logs" Foreground="{StaticResource MutedBrush}" />
                                <TextBox Grid.Row="2" Grid.Column="1" Text="{Binding LogsFolder, Mode=OneWay}" IsReadOnly="True" BorderThickness="0" Background="Transparent" />
                            </Grid>
                            <WrapPanel Margin="0,12,0,0">
                                <Button Content="Abrir pasta de dados" Command="{Binding OpenDataFolderCommand}" Margin="0,0,10,0" />
                                <Button Content="Abrir pasta de logs" Command="{Binding OpenLogsFolderCommand}" />
                            </WrapPanel>
                            <TextBlock TextWrapping="Wrap" Margin="0,10,0,0" Style="{StaticResource MutedText}"
                                       Text="Para remover todos os dados, feche o aplicativo e apague a pasta de dados. O aplicativo não instala nada e não inicia com o Windows." />
                        </StackPanel>
                    </Border>

                    <Border Style="{StaticResource Card}">
                        <StackPanel>
                            <TextBlock Text="LIMITAÇÕES CONHECIDAS" Style="{StaticResource SectionText}" />
                            <TextBlock TextWrapping="Wrap" Text="• A temperatura vem apenas das zonas térmicas do firmware (ACPI) expostas pelo Windows. Uma zona térmica não é necessariamente o sensor do núcleo da CPU, e muitos computadores não expõem nenhuma — nesse caso aparece como Indisponível. Os valores nunca são estimados." />
                            <TextBlock TextWrapping="Wrap" Margin="0,4,0,0" Text="• O uso de CPU é baseado em tempo; o Gerenciador de Tarefas mostra a “utilidade do processador”, que também considera a frequência, então os valores podem diferir um pouco." />
                            <TextBlock TextWrapping="Wrap" Margin="0,4,0,0" Text="• A memória por processo é o working set (inclui páginas compartilhadas); o Gerenciador de Tarefas mostra, por padrão, o working set privado." />
                            <TextBlock TextWrapping="Wrap" Margin="0,4,0,0" Text="• A saúde física dos discos (SMART), GPU, bateria e rede não são avaliadas nesta versão." />
                        </StackPanel>
                    </Border>
                </StackPanel>
            </ScrollViewer>
        </TabItem>
    </TabControl>
</Window>
